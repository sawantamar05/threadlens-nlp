# Optional root override for a separate local dataset/model installation.
# Default: this repository directory. Launch commands use loopback only.
# THREADLENS_ROOT=/absolute/path/to/threadlens-nlp
THREADLENS_API_URL=http://127.0.0.1:8000
# First model downloads require internet. Set only after downloading artifacts:
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
